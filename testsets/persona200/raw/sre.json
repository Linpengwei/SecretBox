yst\nCLICKHOUSE_PASSWORD=Analytics2024","primary_secret":null,"name":null,"notes":null,"tags":["clickhouse","analytics","ops"],"fields":[]},"expect":{"primary_secret":"Analytics2024","template_type":"database","semantic_query":"clickhouse 埋点","semantic_top_n":5}},{"title":"日志中心 clickhouse 账号","story":"日志中心的 clickhouse 写入账号，密码里有 # 号。","difficulty":"medium","create":{"pasted_text":"CLICKHOUSE_HOST=ck-log.db.internal\nCLICKHOUSE_USER=logwriter\nCLICKHOUSE_PASSWORD=Log#Write2024","primary_secret":null,"name":null,"notes":null,"tags":["clickhouse","log","staging"],"fields":[]},"expect":{"primary_secret":"Log#Write2024","template_type":"database","semantic_query":"ck-log clickhouse","semantic_top_n":5}},{"title":"用户画像 mongodb 连接串","story":"用户画像 mongodb 连接串，密码里的 @ 被编码成 %40。","difficulty":"medium","create":{"pasted_text":"mongodb://profile_user:Profile%40Mongo2024@mongo-profile-01.db.internal:27017/profile_db?authSource=admin","primary_secret":null,"name":null,"notes":null,"tags":["mongodb","profile","prod"],"fields":[]},"expect":{"primary_secret":"Profile@Mongo2024","template_type":"database","semantic_query":"mongo profile 连接串","semantic_top_n":5}},{"title":"订单 JDBC 连接串","story":"Java 服务连订单库的 jdbc url，密码在 query 参数里带 URL 转义。","difficulty":"hard","create":{"pasted_text":"jdbc:postgresql://pg-order-01.db.internal:5432/order_db?user=order_app&password=Jdbc%40Order2024&ssl=true","primary_secret":null,"name":null,"notes":null,"tags":["jdbc","postgres","order"],"fields":[]},"expect":{"primary_secret":"Jdbc@Order2024","template_type":"database","semantic_query":"order jdbc 连接串","semantic_top_n":5}},{"title":"备份桶 aws 密钥","story":"备份任务用的 aws access key，kv 格式直接粘。","difficulty":"easy","create":{"pasted_text":"AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE\nAWS_SECRET_ACCESS_KEY=BackupS3Secret2024\nAWS_REGION=ap-east-1","primary_secret":null,"name":null,"notes":null,"tags":["s3","aws","backup"],"fields":[]},"expect":{"primary_secret":"BackupS3Secret2024","template_type":"s3","semantic_query":