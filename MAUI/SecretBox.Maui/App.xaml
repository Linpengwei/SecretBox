<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SecretBox.Maui.App">
  <Application.Resources>
    <ResourceDictionary>
      <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F7F8FA, Dark=#15181F}" /></Style>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#172033, Dark=#EDF1F7}" />
        <Setter Property="FontSize" Value="14" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="#2563EB" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="14,8" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#172033, Dark=#EDF1F7}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#6B7280, Dark=#A3ACBC}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
      </Style>
      <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#172033, Dark=#EDF1F7}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#6B7280, Dark=#A3ACBC}" />
      </Style>
      <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#172033, Dark=#EDF1F7}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
