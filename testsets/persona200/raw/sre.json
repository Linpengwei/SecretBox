et:9092\nsecurity.protocol=SASL_PLAINTEXT\nsasl.username=tracking\nsasl.password=TrackingKafka2024","primary_secret":null,"name":null,"notes":null,"tags":["kafka","tracking","ops"],"fields":[]},"expect":{"primary_secret":"TrackingKafka2024","template_type":"kafka","semantic_query":"tracking kafka 认证","semantic_top_n":5}},{"title":"支付回调 topic 配置","story":"支付回调 topic 和对应环境的 kafka 密码写在一起。","difficulty":"medium","create":{"pasted_text":"TOPIC=payment-callback\nENV=prod\nKAFKA_BROKER=kafka-pay.internal:9092\nPASSWORD=PayCallback2024","primary_secret":null,"name":null,"notes":null,"tags":["kafka","payment","prod"],"fields":[]},"expect":{"primary_secret":"PayCallback2024","template_type":"kafka","semantic_query":"payment-callback topic","semantic_top_n":5}},{"title":"风控 topic 消费配置","story":"风控规则变更 topic 的消费配置，密码单独一行。","difficulty":"medium","create":{"pasted_text":"env=staging\ntopic=risk-rule-change\nbootstrap.servers=kafka-risk.internal:9092\nsasl.password=RiskRuleTopic2024","primary_secret":null,"name":null,"notes":null,"tags":["kafka","risk","staging"],"fields":[]},"expect":{"primary_secret":"RiskRuleTopic2024","template_type":"kafka","semantic_query":"risk-rule-change topic","semantic_top_n":5}},{"title":"kafka connect worker SASL","story":"kafka connect 集群的 worker 配置，SASL 密码带 # 号。","difficulty":"hard","create":{"pasted_text":"worker.properties:\nbootstrap.servers=connect-kafka.internal:9092\nsasl.mechanism=PLAIN\nsasl.username=connect-worker\nsasl.password=Connect#Worker2024","primary_secret":null,"name":null,"notes":null,"tags":["kafka","connect"],"fields":[]},"expect":{"primary_secret":"Connect#Worker2024","template_type":"kafka","semantic_query":"connect worker kafka","semantic_top_n":5}},{"title":"sink 连接器配置带转义密码","story":"kafka connect 的 sink 配置，密码里含 @ 和 %，properties 原样抄。","difficulty":"hard","create":{"pasted_text":"connector.class=ElasticsearchSinkConnector\ntasks.max=4\nbootstrap.servers=sink-kafka.internal:9092\nsasl.password=Sink%Connector@2024\nsasl.usernam