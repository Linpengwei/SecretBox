he2024","template_type":"redis","semantic_query":"rec redis 密码","semantic_top_n":5}},{"title":"库存 redis 多 kv 同行","story":"从配置中心抄的库存缓存连接，几个 kv 挤在一行里了。","difficulty":"medium","create":{"pasted_text":"REDIS_HOST=stock-cache.redis.internal REDIS_PASSWORD=StockCache2024 REDIS_PORT=6379","primary_secret":null,"name":null,"notes":null,"tags":["redis","stock","ops"],"fields":[]},"expect":{"primary_secret":"StockCache2024","template_type":"redis","semantic_query":"stock-cache redis","semantic_top_n":5}},{"title":"prod redis 命令行认证","story":"用 REDISCLI_AUTH 登 prod redis 的命令，整条命令直接存下来。","difficulty":"easy","create":{"pasted_text":"REDISCLI_AUTH=ProdRedisAuth2024 redis-cli -h prod-redis-01.redis.internal -p 6379","primary_secret":null,"name":null,"notes":null,"tags":["redis","prod","redis-cli"],"fields":[]},"expect":{"primary_secret":"ProdRedisAuth2024","template_type":"redis","semantic_query":"prod redis redis-cli","semantic_top_n":5}},{"title":"ops redis 认证命令","story":"排查热 key 时用 ops 环境 redis 的认证命令，带了个尾部注释。","difficulty":"medium","create":{"pasted_text":"REDISCLI_AUTH=OpsRedis2024 redis-cli -h ops-redis-01.redis.internal -p 6381 --raw\n# 查看热 key","primary_secret":null,"name":null,"notes":null,"tags":["redis","ops"],"fields":[]},"expect":{"primary_secret":"OpsRedis2024","template_type":"redis","semantic_query":"ops redis","semantic_top_n":5}},{"title":"购物车 redis prod 库","story":"购物车 prod 和 staging 共用一台 redis 主机，只差 db 号和密码，我存的时候特意标了 prod。","difficulty":"medium","create":{"pasted_text":"redis://:CartProd2024@cart-redis.internal:6379/0  # prod 购物车","primary_secret":null,"name":null,"notes":null,"tags":["redis","cart","prod"],"fields":[]},"expect":{"primary_secret":"CartProd2024","template_type":"redis","semantic_query":"cart redis prod","semantic_top_n":5}},{"title":"购物车 redis staging 库","story":"staging 购物车和 prod 同主机不同 db，密码也不一样，最容易抄错的一条。","difficulty":"hard","create":{"pasted_text":"redis://:CartStage2024@cart-redis.internal:6379/1\n# staging 购物车，别连成 prod 的 db0","primary_secret"